APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-6-astra
AI_MAX_TOKENS=1200
AI_TEMPERATURE=0.2
AI_TIMEOUT=30
AI_RETRIES=1
AI_INPUT_COST_PER_MILLION_TOKENS=0
AI_OUTPUT_COST_PER_MILLION_TOKENS=0
EMAIL_REPLY_WEBHOOK_SECRET=
LEADS_DISCOVERY_SCHEDULE_ENABLED=true
LEADS_DISCOVERY_CRON="0 * * * *"
LEADS_DISCOVERY_LIMIT=50
LEADS_DISCOVERY_RUN_INLINE=false
LEADS_PROCESSING_SCHEDULE_ENABLED=true
LEADS_PROCESSING_CRON="*/15 * * * *"
LEADS_PROCESSING_LIMIT=100
LEADS_PROCESSING_RUN_INLINE=false
LEADS_ANALYSIS_SCHEDULE_ENABLED=true
LEADS_ANALYSIS_CRON="*/30 * * * *"
LEADS_ANALYSIS_LIMIT=25
LEADS_ANALYSIS_RUN_INLINE=false
LEADS_OUTREACH_RUN_INLINE=false
LEADS_REPORT_SCHEDULE_ENABLED=true
LEADS_REPORT_CRON="0 8 * * *"
LEADS_SEARCH_ENDPOINT=
LEADS_SEARCH_METHOD=GET
LEADS_SEARCH_QUERY_PARAMETER=q
LEADS_SEARCH_RESULTS_PATH=
LEADS_SEARCH_API_KEY=
LEADS_SEARCH_API_KEY_HEADER=
LEADS_SEARCH_API_KEY_QUERY_PARAMETER=
LEADS_SEARCH_QUERY='{}'
LEADS_SEARCH_HEADERS='{}'
LEADS_SEARCH_MAX_QUERIES_PER_RUN=3
LEADS_SEARCH_TIMEOUT=20
LEADS_SEARCH_USER_AGENT=
LEADS_LINKEDIN_SOURCE_ENABLED=false
LEADS_FACEBOOK_SOURCE_ENABLED=false
LEADS_TWITTER_SOURCE_ENABLED=false

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Apple StoreKit In-App Purchase
APPLE_IAP_BUNDLE_ID=com.baheth.school
APPLE_IAP_COURSE_PRODUCT_PREFIX=com.baheth.school.course.v2.
# App Review uses Sandbox transactions against the production API.
APPLE_IAP_ALLOWED_ENVIRONMENTS=Production,Sandbox
APPLE_IAP_MAX_CLOCK_SKEW_SECONDS=300

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
